{
  "name": "dealscout-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DealScout AI – automatische Deal-Suche mit KI-Bewertung auf Cloudflare Workers",
  "scripts": {
    "dev": "vite",
    "dev:offline": "LOCAL_ONLY=1 vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && wrangler dev --local",
    "deploy": "npm run build && wrangler d1 migrations apply dealscout-db --remote && wrangler deploy",
    "db:create": "wrangler d1 create dealscout-db",
    "db:migrate:local": "wrangler d1 migrations apply dealscout-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply dealscout-db --remote",
    "db:schema:local": "wrangler d1 execute dealscout-db --local --file=./schema.sql",
    "db:schema:remote": "wrangler d1 execute dealscout-db --remote --file=./schema.sql",
    "cron:local": "curl -s \"http://localhost:5173/cdn-cgi/handler/scheduled?cron=0+*/6+*+*+*\"",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "hono": "^4.13.19",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@cloudflare/workers-types": "^5.20261116.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.163.0"
  }
}
